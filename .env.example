# Azure OpenAI (used for GPT-4o via .env and GPT-5.2 via .env.gpt52)
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure-hosted Anthropic Claude (put these in .env.claude)
AZURE_ANTHROPIC_API_KEY=your-key-here
AZURE_ANTHROPIC_ENDPOINT=https://your-resource.services.ai.azure.com/
AZURE_ANTHROPIC_DEPLOYMENT=your-claude-deployment-name
AZURE_ANTHROPIC_API_VERSION=2024-02-01
